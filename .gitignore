/target
/worlds
*.json.tmp
# Generated by tauri-build on every build
/crates/hearth-desktop/gen/
# Local-only content that can't be redistributed (e.g. a Pathfinder system built
# from licensed books): keep it in /local, never committed.
/local/
# Downloaded rules sources used by tools/ importers (fetched, not committed).
/tools/*/source/
